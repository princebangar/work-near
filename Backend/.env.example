#WorkNear Backend Env
# Server Configuration
PORT=5000
NODE_ENV=development
#NODE_ENV=production
LOG_LEVEL=info
# Large JSON bodies are not expected — files go via multipart/signed uploads.
REQUEST_JSON_LIMIT=100kb
# Proxy hops in front of the API so rate limits see the real client IP:
# 1 = one load balancer / nginx, 2 = Cloudflare + nginx. Wrong value = every user shares one IP bucket.
TRUST_PROXY=1

# MongoDB Configuration
MONGODB_URI=

# JWT Configuration (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
# Access tokens are refreshed automatically by the app — keep them short-lived in production (e.g. 1d)
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d

# Frontend URL (for CORS) — comma-separate multiple origins
FRONTEND_URL=http://localhost:5173,https://worknearme.netlify.app
SOCKET_CORS_ORIGIN=http://localhost:5173,https://worknearme.netlify.app

# Redis — REQUIRED when running more than one API instance behind a load balancer
# (shares rate-limit counters + relays Socket.IO chat events between instances). Single instance: leave false.
REDIS_ENABLED=false
REDIS_URL=

##################################################
# HTTP RATE LIMITING
##################################################
RATE_LIMIT_ENABLED=true
# General APIs (minutes / max requests per IP)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=3000
# Development limit (used when NODE_ENV=development)
RATE_LIMIT_DEV_MAX=2000
# Authentication routes (OTP / refresh — keyed by phone + IP)
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=30
# Per-route limits (see src/lib/limits.ts)
OTP_IP_RATE_LIMIT=20
ADMIN_LOGIN_RATE_LIMIT=10
SEARCH_RATE_LIMIT=60
UPLOAD_RATE_LIMIT=30
REPORT_RATE_LIMIT=10

# ==================================================
# PASSWORD HASHING (admin / staff accounts)
# ==================================================
# bcrypt cost factor. 10 = minimum allowed (boot fails below 10); each +1 doubles login CPU time.
BCRYPT_SALT_ROUNDS=10

# Google Maps API Configuration (server-side geocoding; restrict by server IP)
GOOGLE_MAPS_API_KEY=

# Optional one-time bootstrap code for POST /admin/auth/register (works only while no admin exists).
# Leave empty in production unless needed; min 16 chars in production.
ADMIN_REGISTRATION_CODE=

# Razorpay Configuration (subscriptions ₹30 / ₹300)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==================================================
# SMS INDIA HUB CONFIGURATION
# ==================================================
# Get these from your SMS India Hub account. Message text must match the DLT template exactly ({otp} = code).
SMS_HUB_ENABLED=false
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_PEID=
SMS_INDIA_HUB_OTP_MESSAGE=Your WorkNear OTP is {otp}. Valid for 5 minutes. Do not share it with anyone.

# ==================================================
# OTP CONFIGURATION
# ==================================================
# true = every number gets DEFAULT_OTP, no SMS sent (works in production too — set false once SMS is live)
USE_DEFAULT_OTP=true
DEFAULT_OTP=123456
# Phone-scoped default OTP for one QA number (works in production too)
USE_DEFAULT_TEST_PHONE=false
DEFAULT_TEST_PHONE=
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=4
# Max OTP requests per phone within OTP_RATE_WINDOW seconds
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600
OTP_RESEND_SECONDS=30

# ==================================================
# FIREBASE (FCM push notifications) — same project as frontend VITE_FIREBASE_PROJECT_ID
# ==================================================
# Either the service-account JSON on one line (single quotes) or a path to the JSON file.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ==================================================
# FILE UPLOADS (local disk; move to object storage later)
# ==================================================
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private-uploads
MAX_UPLOAD_MB=5
# Public origin of this API for absolute media URLs (leave empty in dev)
PUBLIC_URL=

# ==================================================
# FIRST SUPER ADMIN — created only when you run `npm run seed:admin` (never on server start).
# Change the password from the admin panel after first login, then you may clear it here.
# ==================================================
SEED_ADMIN_EMAIL=worknear@admin.com
SEED_ADMIN_PASSWORD=
