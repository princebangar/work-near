#WorkNear Frontend Env
# API
VITE_API_BASE_URL=/api/v1
#VITE_API_BASE_URL=https://api.worknear.in/api/v1
# Backend origin for /uploads media and Socket.IO. Empty = same origin (Vite dev proxy). Production: https://api.your-domain
VITE_BACKEND_ORIGIN=
VITE_SOCKET_URL=

# Shared OTP test phone — match Backend DEFAULT_TEST_PHONE
VITE_USE_DEFAULT_TEST_PHONE=false
VITE_DEFAULT_TEST_PHONE=

#MAP CONFIGURATION (Maps JavaScript + Places + Geocoding; restrict by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY=

#Razorpay config (public key id only — secret stays on backend)
VITE_RAZORPAY_KEY_ID=

#FIREBASE CONFIG (push notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
