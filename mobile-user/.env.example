# WorkNear Android app — public (client-side) values only. Secrets stay in Backend/.env.

# Deployed backend (AWS, worknear.in). REST under /api/v1; /uploads media and Socket.IO on the same origin.
EXPO_PUBLIC_API_BASE_URL=https://worknear.in/api/v1
EXPO_PUBLIC_BACKEND_ORIGIN=https://worknear.in

# Google Maps (Android Maps SDK + Geocoding + Places API New) — same key as Frontend/.env VITE_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBQBGa2CYA0SzHk_2zIXoQInIoDrhAU4Rk

# Razorpay public key id (fallback; the server sends keyId with every checkout order)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_T2IBdxMTde7P65

# Public web origin, used for shared worker-profile links
EXPO_PUBLIC_WEB_ORIGIN=https://worknear.in
