{
  "expo": {
    "name": "Work Near",
    "slug": "worknear-user",
    "scheme": "worknear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "android": {
      "package": "com.worknear.user",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15803d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#15803d",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Work Near uses your location to show workers near you and to set a worker's service area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Work Near needs your photos to upload a profile picture, work photos or chat images.",
          "cameraPermission": "Work Near uses your camera to take a profile picture or a photo to send in chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#15803d",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": ""
        }
      ],
      "./plugins/withReleaseSigning.js",
      "./plugins/withWindowsCmake.js",
      "./plugins/withReleaseNoMinify.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
